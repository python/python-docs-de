#: ../../library/tokenize.rst:339
msgid ""
"Example of tokenizing a file programmatically, reading unicode strings "
"instead of bytes with :func:`generate_tokens`::"
msgstr ""
"Beispiel für das Zerlegen einer Datei aus dem Programm heraus, wobei "
"mit :func:`generate_tokens` Unicode-Zeichenketten statt Bytes gelesen "
"werden::"

#: ../../library/tokenize.rst:342
msgid ""
"import tokenize\n"
"\n"
"with tokenize.open('hello.py') as f:\n"
"    tokens = tokenize.generate_tokens(f.readline)\n"
"    for token in tokens:\n"
"        print(token)"
msgstr ""
"import tokenize\n"
"\n"
"with tokenize.open('hello.py') as f:\n"
"    tokens = tokenize.generate_tokens(f.readline)\n"
"    for token in tokens:\n"
"        print(token)"

#: ../../library/tokenize.rst:349
msgid "Or reading bytes directly with :func:`.tokenize`::"
msgstr "Oder, mit :func:`.tokenize` direkt Bytes gelesen::"

#: ../../library/tokenize.rst:351
msgid ""
"import tokenize\n"
"\n"
"with open('hello.py', 'rb') as f:\n"
"    tokens = tokenize.tokenize(f.readline)\n"
"    for token in tokens:\n"
"        print(token)"
msgstr ""
"import tokenize\n"
"\n"
"with open('hello.py', 'rb') as f:\n"
"    tokens = tokenize.tokenize(f.readline)\n"
"    for token in tokens:\n"
"        print(token)"
