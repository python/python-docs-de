msgstr "Spielt den Klang ``SystemExclamation`` ab."

#: ../../library/winsound.rst:184 ../../library/winsound.rst:199
#: ../../library/winsound.rst:213
msgid "Play the ``SystemHand`` sound."
msgstr "Spielt den Klang ``SystemHand`` ab."

#: ../../library/winsound.rst:189
msgid "Play the ``SystemQuestion`` sound."
msgstr "Spielt den Klang ``SystemQuestion`` ab."
