">>> S = \"\"\"This  sentence  has a bunch   of\n"
"...   extra   whitespace.\"\"\"\n"
">>> print textwrap.fill(S, width=15)\n"
"This  sentence\n"
"has a bunch\n"
"of    extra\n"
"whitespace.\n"
