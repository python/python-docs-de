"    @property\n"
"    def x(self):\n"
"        return self._x\n"
"\n"
"    @x.setter\n"
"    def x(self, value):\n"
"        self._x = value\n"
"\n"
"    @x.deleter\n"
"    def x(self):\n"
"        del self._x\n"
"\n"
"class D(C):\n"
"    @C.x.getter\n"
"    def x(self):\n"
"        return self._x * 2\n"
"\n"
"    @x.setter\n"
"    def x(self, value):\n"
"        self._x = value / 2"

