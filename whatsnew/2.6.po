"    if isinstance(format_spec, unicode):\n"
"        return unicode(str(self))\n"
"    else:\n"
"        return str(self)"
msgstr ""
"def __format__(self, format_spec):\n"
"    if isinstance(format_spec, unicode):\n"
"        return unicode(str(self))\n"
"    else:\n"
"        return str(self)"

#: ../../whatsnew/2.6.rst:844
