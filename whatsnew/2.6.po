"    d[i + i] = ord(i) - ord('a') + 1\n"
"print d\n"
"\"\"\")\n"
"print ast.dump(t)"
msgstr ""
"import ast\n"
"\n"
"t = ast.parse(\"\"\"\n"
"d = {}\n"
"for i in 'abcdefghijklm':\n"
"    d[i + i] = ord(i) - ord('a') + 1\n"
"print d\n"
"\"\"\")\n"
"print ast.dump(t)"

