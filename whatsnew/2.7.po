">>> b\n"
"bytearray(b'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ')\n"
">>> mb = memoryview(b)\n"
">>> mb[0] = '*'         # Assign to view, changing the bytearray.\n"
">>> b[0:5]              # The bytearray has been changed.\n"
