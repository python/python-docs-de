#: ../../whatsnew/2.1.rst:3
msgid "What's New in Python 2.1"
msgstr "Was ist neu in Python 2.1"

#: ../../whatsnew/2.1.rst:0
msgid "Author"
msgstr "Autor"

#: ../../whatsnew/2.1.rst:5
