"nächste :meth:`~curses.window.get_wch` es zurückgibt"

#: ../../whatsnew/3.3.rst:1076
msgid "(Contributed by Iñigo Serna in :issue:`6755`.)"
msgstr "(Beigetragen von Iñigo Serna in :issue:`6755`.)"

#: ../../whatsnew/3.3.rst:1079
msgid "datetime"
msgstr "datetime"

#: ../../whatsnew/3.3.rst:1081
msgid ""
