msgid ""
">>> parser = ConfigParser()\n"
">>> parser.read_string(\"\"\"\n"
"... [DEFAULT]\n"
"... location = upper left\n"
"... visible = yes\n"
"... editable = no\n"
"... color = blue\n"
"...\n"
"... [main]\n"
"... title = Main Menu\n"
"... color = green\n"
"...\n"
"... [options]\n"
"... title = Options\n"
"... \"\"\")\n"
">>> parser['main']['color']\n"
"'green'\n"
">>> parser['main']['editable']\n"
"'no'\n"
">>> section = parser['options']\n"
">>> section['title']\n"
"'Options'\n"
">>> section['title'] = 'Options (editable: %(editable)s)'\n"
">>> section['title']\n"
"'Options (editable: no)'"
